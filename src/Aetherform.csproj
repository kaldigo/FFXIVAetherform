<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.4.0</Version><AssemblyName>Aetherform</AssemblyName>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudDir>
  </PropertyGroup>
  <PropertyGroup>
    <AetherglassSource Condition="Exists('../vendor/AetherglassUI/Library/AetherglassUI.csproj')">../vendor/AetherglassUI</AetherglassSource>
    <AetherglassSource Condition="'$(AetherglassSource)' == ''">../../AetherglassUI</AetherglassSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../solver/Headless.csproj" />
    <Reference Include="Dalamud" HintPath="$(DalamudDir)/Dalamud.dll" Private="false"/>
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudDir)/Dalamud.Bindings.ImGui.dll" Private="false"/>
    <ProjectReference Include="$(AetherglassSource)/Library/AetherglassUI.csproj" />
    <Reference Include="HexaGen.Runtime" HintPath="$(DalamudDir)/HexaGen.Runtime.dll" Private="false"/>
    <EmbeddedResource Include="../classifications/*.json" LogicalName="Aetherform.classifications.%(Filename).json" />
    <EmbeddedResource Include="../assets/motion.json.gz" LogicalName="Aetherform.motion.json.gz"/>
    <EmbeddedResource Include="../assets/mark.png" LogicalName="Aetherform.mark.png"/>
    <None Update="Aetherform.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Lumina" HintPath="$(DalamudDir)/Lumina.dll" Private="false"/>
  </ItemGroup>
</Project>
