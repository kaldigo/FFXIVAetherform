<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The pinned geometry library exposes its headless API to this assembly. -->
    <AssemblyName>Proteus.Refit</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SkinRoutes/*.gz" LogicalName="Aetherform.skinroutes.%(Filename).gz" />
    <EmbeddedResource Include="NativeMorph.map.gz" LogicalName="Aetherform.NativeMorph.map.gz" />
    <EmbeddedResource Include="VanillaAF.map.gz" LogicalName="Aetherform.VanillaAF.map.gz" />
    <Reference Include="Proteus" HintPath="../vendor/proteus/lib/Proteus.dll" />
    <Reference Include="XivLiveMesh" HintPath="../vendor/proteus/lib/XivLiveMesh.dll" />
    <Reference Include="Dalamud" HintPath="$(DalamudDir)/Dalamud.dll" Private="false"/>
  </ItemGroup>
</Project>
